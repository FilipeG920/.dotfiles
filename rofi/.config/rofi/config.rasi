/* ==========================================================================
   Rofi — Material Design 3, adaptive via iris
   --------------------------------------------------------------------------
   Requires ~/.cache/iris/rofi-colors.rasi to exist (generated by iris from
   the rofi-colors.rasi template). Run `iris <wallpaper>` at least once first.

   Iris integration is intentionally kept unchanged.
   ========================================================================== */

@import "~/.cache/iris/rofi-colors.rasi"

configuration {
    font: "Oxanium Medium 13";
    modi: "drun";
    show-icons: true;
    sort: true;
    sorting-method: "fzf";
    display-drun: "Search apps";
    drun-display-format: "{name}";
    icon-theme: "Papirus-Dark";
}

* {
    spacing: 0;
    margin: 0;
    padding: 0;
}

/* ---- M3 window surface -------------------------------------------------- */
window {
    transparency: "real";
    width: 660px;
    background-color: @card;
    border: 1px solid;
    border-color: @border;
    border-radius: 28px;
    padding: 10px;
}

mainbox {
    background-color: transparent;
    spacing: 10px;
    padding: 0;
}

/* ---- M3 filled search field -------------------------------------------- */
inputbar {
    children: [prompt, entry];
    spacing: 10px;
    padding: 12px 16px;
    background-color: @background;
    border: 1px solid;
    border-color: @border;
    border-radius: 20px;
}

prompt {
    enabled: false;
    background-color: transparent;
    text-color: @muted-foreground;
}

entry {
    background-color: transparent;
    text-color: @foreground;
    placeholder: "Search apps";
    placeholder-color: @muted-foreground;
}

/* ---- app list ----------------------------------------------------------- */
listview {
    columns: 1;
    lines: 8;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: true;
    spacing: 4px;
    padding: 2px;
    background-color: transparent;
}

/* ---- M3 list items / state layers -------------------------------------- */
element {
    padding: 10px 12px;
    spacing: 12px;
    border: 0;
    border-radius: 16px;
    background-color: transparent;
    text-color: @foreground;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal,
element selected.active {
    background-color: @selected;
    text-color: @primary;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @destructive;
}

element selected.urgent {
    background-color: @selected;
    text-color: @destructive;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @foreground;
}

/* ---- icon + label ------------------------------------------------------- */
element-icon {
    size: 28px;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element-text selected.normal {
    highlight: none;
}

/* ---- M3 rounded scrollbar ---------------------------------------------- */
scrollbar {
    width: 4px;
    border: 0;
    padding: 0;
    margin: 8px 2px;
    handle-color: @muted-foreground;
    handle-width: 4px;
    background-color: transparent;
}

/* ---- message / error surface ------------------------------------------- */
message {
    background-color: @background;
    border: 1px solid;
    border-color: @border;
    border-radius: 16px;
    padding: 10px 14px;
}

textbox {
    background-color: transparent;
    text-color: @foreground;
    highlight: @highlight-match;
}
