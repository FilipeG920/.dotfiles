/* ==========================================================================
   Rofi — shadcn/ui (cmdk) inspired theme, adaptive via iris
   --------------------------------------------------------------------------
   Requires ~/.cache/iris/rofi-colors.rasi to exist (generated by iris from
   the rofi-colors.rasi template). Run `iris <wallpaper>` at least once first.
   If "~" doesn't expand in @import on your build, use the absolute path.
   ========================================================================== */

@import "~/.cache/iris/rofi-colors.rasi"

configuration {
    font: "Oxanium Medium 13";
    modi: "drun";
    show-icons: true;
    sort: true;
    sorting-method: "fzf";
    display-drun: "Search apps";
    drun-display-format: "{name}";
    icon-theme: "Papirus-Dark";       /* change to your icon theme */
}

* {
    spacing: 0;
    margin: 0;
    padding: 0;
}

/* ---- window: one solid card ------------------------------------------- */
window {
    transparency: "real";
    width: 640px;
    background-color: @card;
    border: 1px solid;
    border-color: @border;
    border-radius: 10px;
    padding: 0;
}

mainbox {
    background-color: transparent;
    padding: 0;
    spacing: 0;
}

/* ---- input bar: cmdk-style header with separator ---------------------- */
inputbar {
    children: [prompt, entry];
    spacing: 10px;
    padding: 14px 16px;
    background-color: transparent;
    border: 0 0 1px 0;
    border-color: @border;
}

prompt {
    text-color: @muted-foreground;
    enabled: false;                   /* display-drun doubles as placeholder */
}

entry {
    text-color: @foreground;
    placeholder: "Search apps";
    placeholder-color: @muted-foreground;
    background-color: transparent;
}

/* ---- list -------------------------------------------------------------- */
listview {
    columns: 1;
    lines: 8;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: true;
    spacing: 2px;
    padding: 8px;
    background-color: transparent;
}

element {
    padding: 8px 10px;
    spacing: 10px;
    border: 0;
    border-radius: 6px;
    background-color: transparent;
    text-color: @foreground;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

/* selected = soft accent badge, shadcn style (tinted bg, accent text) */
element selected.normal,
element selected.active {
    background-color: @selected;
    text-color: @primary;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @destructive;
}

element selected.urgent {
    background-color: @selected;
    text-color: @destructive;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @foreground;
}

element-text,
element-icon {
    background-color: inherit;
    text-color: inherit;
}

element-text selected.normal {
    highlight: none;
}

/* ---- scrollbar: thin, unobtrusive --------------------------------------- */
scrollbar {
    width: 4px;
    border: 0;
    padding: 0;
    margin: 4px 2px;
    handle-color: @muted-foreground;
    handle-width: 4px;
    background-color: transparent;
}

/* ---- message / misc ----------------------------------------------------- */
message {
    background-color: transparent;
    border: 1px 0 0 0;
    border-color: @border;
    padding: 10px 16px;
}

textbox {
    text-color: @foreground;
    highlight: @highlight-match;
}
