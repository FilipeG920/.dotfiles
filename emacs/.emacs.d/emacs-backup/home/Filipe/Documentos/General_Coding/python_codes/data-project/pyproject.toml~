[project]
name = "data-project"
version = "0.1.0"
description = "Add your description here"
readme = "README.md"
authors = [
    { name = "FilipeG920", email = "genesisfilipe11@gmail.com" }
]
requires-python = ">=3.13"
dependencies = [
    "matplotlib>=3.11.2",
    "numpy>=2.5.3",
    "pandas>=3.0.6",
    "scikit-learn>=1.9.1",
    "scipy>=1.18.1",
]

[project.scripts]
data-project = "data_project:main"

[build-system]
requires = ["uv_build>=0.12.20,<0.13.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "basedpyright>=1.40.1",
    "ipykernel>=7.4.0",
    "jupyterlab>=4.6.4",
    "jupytext>=1.19.5",
    "ruff>=0.16.9",
]
