{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
      "width": 10
    },
    "size": {
      "binaryPrefix": "jedec"
    },
    "separator": ""
  },
  "logo": {
    "source": "~/.config/fastfetch/logos/arch.txt",
    "width": 20,
    "height": 10
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "yellow",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "KER",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "PKGS",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "TERM",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "SH",
      "keyColor": "magenta",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "red",
      "format": "{pretty-name}"
    },
       {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "yellow",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "green",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "cyan",
      "format": "{used} / {total}"
    },
    {
      "type": "swap",
      "key": "SWAP",
      "keyColor": "cyan",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "DISK",
      "keyColor": "blue",
      "format": "{size-used} / {size-total} [{filesystem}] ({mountpoint})"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[33m󰮯 \u001b[32m󰊠 \u001b[34m󰊠 \u001b[31m󰊠 \u001b[36m󰊠 \u001b[35m󰊠 \u001b[37m󰊠 \u001b[97m󰊠"
    }
  ]
}
